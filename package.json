{
  "name": "axios-auth-kit",
  "version": "1.0.0",
  "description": "Axios 增强库：401 无感刷新 Token、刷新期间并发请求排队、重复请求去重、AES/RSA 前端加解密（零依赖，基于 Web Crypto）",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "axios",
    "auth",
    "refresh-token",
    "401",
    "interceptor",
    "dedupe",
    "aes",
    "rsa",
    "crypto",
    "typescript"
  ],
  "author": "jackiechan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcy-24/axios-auth-kit.git"
  },
  "peerDependencies": {
    "axios": ">=1.0.0"
  },
  "devDependencies": {
    "axios": "^1.7.9",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
